{
  "name": "awesome-genome-visualization",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "dev": "vite",
    "build": "tsrs -b && vite build",
    "typecheck": "tsrs -b",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives",
    "check-tools": "node --experimental-strip-types scripts/check_tools.ts",
    "check-tags": "node --experimental-strip-types scripts/check_tags.ts",
    "readme": "node --experimental-strip-types scripts/gen_readme.ts > README.md && oxfmt README.md",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "tsrs": "0.23.0-ts7.1.0-beta",
    "typescript": "^6.0.3",
    "vite": "^8.3.5"
  }
}
